# Normalise line endings. Without this, Git warns "LF will be replaced by CRLF"
# on every add from Windows, and a checkout on another platform produces a diff
# in every file that touched a Windows working tree.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.pdf binary
*.xlsx binary
*.xls binary

# Generated; keep out of diffs and language stats.
uv.lock            linguist-generated=true -diff
skills/**          linguist-documentation=true
